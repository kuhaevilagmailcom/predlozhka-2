BOT_TOKEN=PASTE_BOT_TOKEN_HERE
# Replace both example IDs with your real IDs. They must differ for group-to-channel publishing.
# Send /chatid in your moderation group to get its NEGATIVE chat ID (not your user ID).
# The copied bot never falls back to the original bot's moderation group.
MODERATION_CHAT_ID=-1001234567890
# Separate channel where accepted suggestions are published; bot must be an admin there.
DESTINATION_CHAT_ID=-1009876543210
# CHANNEL_ID is still accepted for older deployments.
# DB_PATH=/data/suggestions.sqlite3
